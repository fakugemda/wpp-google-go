# Puerto en el que correrá el servidor
PORT=8080

# Token secreto para verificar el webhook de Meta
# Este token lo defines tú y debe coincidir con el que configures en Meta Developer Console
VERIFY_TOKEN=tu_token_secreto_aqui

# Access Token de WhatsApp (Bearer Token) - Para enviar mensajes a través de la API
# Obtenlo en: Meta Developer Console > WhatsApp > API Setup > Temporary access token
WHATSAPP_ACCESS_TOKEN=tu_whatsapp_access_token_aqui

# Phone Number ID de WhatsApp Business
# Obtenlo en: Meta Developer Console > WhatsApp > API Setup > Phone number ID
PHONE_NUMBER_ID=tu_phone_number_id_aqui

# API Key de Gemini (Google AI)
# Obtén tu API key en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_gemini_api_key_aqui
